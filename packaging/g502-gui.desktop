[Desktop Entry]
Type=Application
Name=G502 Linux Control
Comment=Inspect and edit the Logitech G502 HERO's onboard profiles, buttons, LEDs and DPI
# ~/.cargo/bin is usually not on a launcher's PATH.
Exec=sh -c "exec \\$HOME/.cargo/bin/g502-gui"
Icon=input-mouse
Terminal=false
Categories=Settings;HardwareSettings;
Keywords=logitech;g502;mouse;dpi;buttons;leds;
StartupNotify=false
